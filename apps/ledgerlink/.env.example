# --- Supabase (required) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only. Used by the public invoice route handlers (external debtor flow)
# and never exposed to the browser. Keep this secret.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public base URL, used to build shareable invoice links (/i/<token>)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Storage bucket for private documents / payment proofs
NEXT_PUBLIC_SUPABASE_DOCS_BUCKET=ledgerlink-docs

# --- Email (Phase 2, optional) ---
# RESEND_API_KEY=
